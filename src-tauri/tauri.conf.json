{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Money Manager",
  "version": "0.1.0",
  "identifier": "com.mostakim.moneymanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Money Manager — Realbyte Parity & Sanchaypatra Tracker",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
